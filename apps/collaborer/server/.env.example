PORT=4000
DATABASE_URL=./data/collaborer.db
AUTH_SECRET=change-me
STORAGE_PATH=./storage
WEBSOCKET_URL=ws://localhost:4000
FRONTEND_URL=http://localhost:4321

# Leave SMTP_HOST unset to use the dev mailer — outgoing mail is logged and
# written to ./data/mail instead of actually being sent. Set these to send
# through a real SMTP server:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Collaborer <no-reply@collaborer.local>
